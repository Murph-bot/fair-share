# Copy to .env for local `npx netlify dev`. Set the same keys in the Netlify UI for production.
PHOTO_PIN_PEPPER=change-me-to-a-long-random-string

# Optional. Without these, Moments still stores compressed JPEGs; originals are skipped.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
