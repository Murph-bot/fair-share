# Local development values. For Cloudflare Pages:
#   - copy this to .dev.vars for `wrangler pages dev`
#   - set the same values as Pages secrets for production:
#     npx wrangler pages secret put PHOTO_PIN_PEPPER
#     npx wrangler pages secret put CRON_SECRET
PHOTO_PIN_PEPPER=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-long-random-string

# Migration only (scripts/migrate-netlify-to-cf.mjs) — needed once to move
# existing trips/photos from Netlify Blobs to D1/R2.
# NETLIFY_SITE_ID=
# NETLIFY_ACCESS_TOKEN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
