{
  "name": "fair-share-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run build:pages && wrangler pages dev web/dist",
    "build": "npm --prefix web run build",
    "build:worker": "esbuild pages/_worker.ts --bundle --format=esm --target=es2022 --outfile=web/dist/_worker.js --log-level=warning",
    "build:pages": "npm run build && npm run build:worker",
    "deploy": "npm run build:pages && test -f web/dist/_worker.js && wrangler pages deploy web/dist --project-name fair-share-trips",
    "typecheck:pages": "tsc --project pages/tsconfig.json --noEmit && tsc --project cron-worker/tsconfig.json --noEmit",
    "clean": "rm -rf web/dist .wrangler .netlify .ruff_cache .coverage '.coverage 2' mobile/.expo && rm -f tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "wrangler": "4.148.0"
  }
}
