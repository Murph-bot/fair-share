{
  "expo": {
    "name": "Fair Share",
    "slug": "fair-share",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fairshare",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.fairshare.trips",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Fair Share uses your photo library so you can add trip photos to Moments.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.fairshare.trips",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fair Share uses your photo library so you can add trip photos to Moments."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "donateUrl": ""
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
